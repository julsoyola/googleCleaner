{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "name": "GoogleCleaner",
  "version": "1.0.3",
  "description": "Personal-use tool to review your own Google Drive files and move selected items to Trash.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GoogleCleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "identity",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://googlecleaner-auth-backend.vercel.app/*"
  ],
  "oauth2": {
    "client_id": "1058637387456-nr0gdht0tfji3bqt5f1t3p02jdj0id8v.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive"
    ]
  }
}
